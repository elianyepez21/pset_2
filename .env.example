# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
# Cuenta de Snowflake: identificador sin ".snowflakecomputing.com", p. ej. xy12345.us-east-1 o miorg-micuenta
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=PSET2_ROLE
SNOWFLAKE_WAREHOUSE=WH_PSET2
SNOWFLAKE_DATABASE=HOTELS_DB

# Fuente de datos (copia pública del dataset Hotel Booking Demand, 119.390 filas)
SOURCE_URL=https://raw.githubusercontent.com/rfordatascience/tidytuesday/master/data/2020/2020-02-11/hotels.csv

# Usuario y contraseña de la interfaz web de Kestra (el usuario debe ser un correo)
KESTRA_USER=admin@example.com
KESTRA_PASSWORD=cambia_esta_clave

# Clave interna de la base Postgres que usa Kestra (inventa una; no es la de Snowflake)
KESTRA_DB_PASSWORD=cambia_esta_clave_interna
